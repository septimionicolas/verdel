# Puerto donde escucha el servidor.
PORT=3005

# Carpeta donde se guarda el registro de pedidos (events.jsonl) y los reportes. Tiene que sobrevivir a un reinicio.
DATA_DIR=./data

# Token del bot, tal como lo entrega @BotFather. Sin token el servidor igual sirve la carta, pero no avisa a Telegram.
TELEGRAM_BOT_TOKEN=

# Token de un bot aparte para cada cocina que es de otro bar. Con token, ese grupo se vincula y recibe sus pedidos solo por ese bot; vacío, usa el bot principal.
PIZZAS_BOT_TOKEN=
HOUSE_BOT_TOKEN=

# Clave de la API de Anthropic. Vacía, la función está apagada: el cierre sale como siempre y la carta no muestra «O contanos con tus palabras». Va solo acá, nunca en el repo.
ANTHROPIC_API_KEY=

# Dirección de la API de Anthropic. Se cambia solo para pruebas con un servidor simulado.
ANTHROPIC_API_BASE=https://api.anthropic.com

# Modelo que escribe el párrafo del cierre y arma las rondas en texto libre.
ADVISOR_MODEL=claude-fable-5-2

# Tope de pedidos en texto libre al modelo por noche, sumando todas las mesas.
ADVISOR_NIGHT_LIMIT=300

# PIN que escribe cada moza la primera vez que escanea un pedido con su celular. 8 caracteres o más (12 o más si son solo números), sin claves de fábrica, repeticiones ni escaleras como 12345678. Si alguna de las tres claves es débil o igual a otra, la carta anda pero el salón y /vincular quedan cerrados.
STAFF_PIN=

# Clave para /vincular: quien la sabe puede decirle al bot qué grupo es cada cosa. 16 caracteres o más.
SETUP_KEY=

# Texto largo al azar que firma los ingresos del salón, de 32 caracteres o más (por ejemplo, la salida de `openssl rand -hex 32`). Cambiarlo cierra todas las sesiones.
SESSION_SECRET=

# true si el servidor está detrás de un proxy que agrega X-Forwarded-For (Railway, nginx, Caddy). Se toma la primera dirección: Railway la pisa con la del celular, y con nginx hay que mandar solo $remote_addr como en docs/instalacion.md. Así cada celular tiene su propio límite de PIN y de consultas.
TRUST_PROXY=false

# Orígenes que pueden llamar a la API desde otro dominio, separados por coma. Vacío si la carta la sirve este mismo servidor.
ALLOWED_ORIGINS=
