# Puerto donde escucha el servidor.
PORT=3005

# Carpeta donde se guarda el registro de pedidos (events.jsonl) y los reportes. Tiene que sobrevivir a un reinicio.
DATA_DIR=./data

# Token del bot, tal como lo entrega @BotFather. Sin token el servidor igual sirve la carta, pero no avisa a Telegram.
TELEGRAM_BOT_TOKEN=

# Token de un bot aparte para cada cocina que es de otro bar. Con token, ese grupo se vincula y recibe sus pedidos solo por ese bot; vacío, usa el bot principal.
PIZZAS_BOT_TOKEN=
HOUSE_BOT_TOKEN=

# PIN que escribe cada moza la primera vez que escanea un pedido con su celular.
STAFF_PIN=

# Clave para /vincular: quien la sabe puede decirle al bot qué grupo es cada cosa.
SETUP_KEY=

# Texto largo al azar que firma los ingresos del salón. Cambiarlo cierra todas las sesiones.
SESSION_SECRET=

# true si el servidor está detrás de un proxy que agrega X-Forwarded-For (Railway, nginx, Caddy). Se toma la última dirección, la que agregó el proxy: así cada celular tiene su propio límite de PIN y de consultas.
TRUST_PROXY=false

# Orígenes que pueden llamar a la API desde otro dominio, separados por coma. Vacío si la carta la sirve este mismo servidor.
ALLOWED_ORIGINS=
