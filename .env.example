# Puerto donde escucha el servidor.
PORT=3005

# Dirección donde escucha. Vacía, escucha en todas las interfaces (lo que pide Railway). En un servidor propio va 127.0.0.1, así nadie entra salteando el proxy: deploy/install.sh la deja así cada vez que corre.
HOST=

# Carpeta donde se guarda el registro de pedidos (events.jsonl) y los reportes. Tiene que sobrevivir a un reinicio y a un despliegue: en Railway, un volumen montado en /data con DATA_DIR=/data, sin excepción.
DATA_DIR=./data

# Token del bot, tal como lo entrega @BotFather. Sin token el servidor igual sirve la carta, pero no avisa a Telegram. Si se filtra: docs/seguridad/respuesta-a-incidentes.md.
TELEGRAM_BOT_TOKEN=

# Token de un bot aparte para cada cocina que es de otro bar. Con token, ese grupo se vincula y recibe sus pedidos solo por ese bot; vacío, usa el bot principal.
PIZZAS_BOT_TOKEN=
HOUSE_BOT_TOKEN=

# Clave de la API de Anthropic. Vacía, la función está apagada: el cierre sale como siempre y la carta no muestra «O contanos con tus palabras». Va solo acá, nunca en el repo.
ANTHROPIC_API_KEY=

# Dirección de la API de Anthropic. Se cambia solo para pruebas con un servidor simulado.
ANTHROPIC_API_BASE=https://api.anthropic.com

# Modelo que escribe el párrafo del cierre y arma las rondas en texto libre.
ADVISOR_MODEL=claude-fable-5-2

# Tope de pedidos en texto libre al modelo por noche, sumando todas las mesas.
ADVISOR_NIGHT_LIMIT=300

# PIN del salón que escribe cada moza al ingresar, junto con su nombre; después se confirma con un toque en Telegram. 8 caracteres o más (12 o más si son solo números), sin claves de fábrica, repeticiones ni escaleras como 12345678. Si alguna de las tres claves es débil o igual a otra, la carta anda pero el salón y /vincular quedan cerrados. Cambiarlo no cierra las sesiones abiertas: para eso, /mozas en Telegram o SESSION_SECRET.
STAFF_PIN=

# Clave para /vincular: quien la sabe puede decirle al bot qué grupo es cada cosa. También es la clave del ingreso de emergencia de una moza, que la tipea el encargado. 16 caracteres o más (por ejemplo, la salida de `openssl rand -hex 16`).
SETUP_KEY=

# Texto largo al azar con el que se guarda la huella de cada ingreso del salón, de 32 caracteres o más (por ejemplo, la salida de `openssl rand -hex 32`). Cambiarlo cierra todas las sesiones.
SESSION_SECRET=

# Horas que dura el ingreso de una moza, como máximo: igual se cierra con el cierre de la noche. Un entero de 1 a 16; cualquier otro valor usa 12.
STAFF_SESSION_HOURS=12

# true deja pedir el ingreso al grupo del salón cuando la moza no tiene Telegram o no está en el grupo. false lo apaga.
STAFF_GROUP_APPROVAL=true

# true deja que el encargado haga entrar a una moza tipeando SETUP_KEY en su celular, con aviso al grupo del dueño. false lo apaga.
STAFF_EMERGENCY_LOGIN=true

# true si el servidor está detrás de un proxy que agrega X-Forwarded-For (Railway, nginx, Caddy). Se toma la primera dirección: Railway la pisa con la del celular, y con nginx hay que mandar solo $remote_addr como en docs/instalacion.md (con Cloudflare delante, además, el real_ip de esa guía). Así cada origen tiene su propio límite de PIN y de consultas; en un bar, todos los celulares comparten el mismo.
TRUST_PROXY=false

# Orígenes que pueden llamar a la API desde otro dominio, separados por coma. Vacío si la carta la sirve este mismo servidor. También son las únicas direcciones, además de la propia, que mesas.html?base= acepta para los QR.
ALLOWED_ORIGINS=
